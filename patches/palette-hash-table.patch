+// A hash table of colours, each of `nb` channel values, with a count and an
+// index kept beside each. The palette search kept its colours in a std::set
+// and a std::map of vectors, so every texel walked down a tree comparing
+// vectors, and a channel palette too wide for a lookup table found each
+// texel's index by a linear search. This finds a colour by its hash and
+// leaves what the search does with the colours as it was.
+class ColorTable {
+ public:
+  ColorTable(size_t nb, size_t expected) : nb_(nb) {
+    colors_.reserve(expected * nb);
+    count.reserve(expected);
+    index.reserve(expected);
+    Resize(expected);
+  }
+
+  size_t size() const { return count.size(); }
+  const pixel_type *Color(size_t i) const { return &colors_[i * nb_]; }
+
+  // The entry of `color`, added with a count of zero if it was not there.
+  size_t Insert(const pixel_type *color, bool *is_new) {
+    size_t slot = Slot(color);
+    for (; slots_[slot] >= 0; slot = (slot + 1) & mask_) {
+      if (Same(slots_[slot], color)) {
+        *is_new = false;
+        return slots_[slot];
+      }
+    }
+    *is_new = true;
+    const size_t entry = size();
+    slots_[slot] = static_cast<int32_t>(entry);
+    colors_.insert(colors_.end(), color, color + nb_);
+    count.push_back(0);
+    index.push_back(0);
+    if (2 * size() > slots_.size()) Resize(size());
+    return entry;
+  }
+
+  // The entry of `color`, or -1 if it is not there.
+  int64_t Find(const pixel_type *color) const {
+    for (size_t slot = Slot(color); slots_[slot] >= 0;
+         slot = (slot + 1) & mask_) {
+      if (Same(slots_[slot], color)) return slots_[slot];
+    }
+    return -1;
+  }
+
+  std::vector<size_t> count;
+  std::vector<size_t> index;
+
+ private:
+  size_t Slot(const pixel_type *color) const {
+    uint64_t hash = 0;
+    for (size_t c = 0; c < nb_; c++) {
+      hash = (hash + static_cast<uint32_t>(color[c])) * 0x9E3779B97F4A7C15ull;
+    }
+    return static_cast<size_t>(hash >> shift_);
+  }
+
+  bool Same(size_t entry, const pixel_type *color) const {
+    const pixel_type *stored = Color(entry);
+    for (size_t c = 0; c < nb_; c++) {
+      if (stored[c] != color[c]) return false;
+    }
+    return true;
+  }
+
+  // At most half the slots are taken, so a probe ends at an empty one.
+  void Resize(size_t entries) {
+    size_t bits = 4;
+    while ((size_t{1} << bits) < 4 * entries) bits++;
+    shift_ = 64 - bits;
+    mask_ = (size_t{1} << bits) - 1;
+    slots_.assign(size_t{1} << bits, -1);
+    for (size_t entry = 0; entry < size(); entry++) {
+      size_t slot = Slot(Color(entry));
+      while (slots_[slot] >= 0) slot = (slot + 1) & mask_;
+      slots_[slot] = static_cast<int32_t>(entry);
+    }
+  }
+
+  size_t nb_;
+  size_t shift_ = 0;
+  size_t mask_ = 0;
+  std::vector<int32_t> slots_;
+  std::vector<pixel_type> colors_;
+};

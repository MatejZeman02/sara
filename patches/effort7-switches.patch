diff --git a/lib/jxl/research_switch.h b/lib/jxl/research_switch.h
new file mode 100644
index 0000000..60fdb2c
--- /dev/null
+++ b/lib/jxl/research_switch.h
@@ -0,0 +1,33 @@
+// Copyright (c) the JPEG XL Project Authors. All rights reserved.
+//
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Not part of libjxl. A switch for measuring effort 8 piece by piece: the
+// environment variable JXL_E7 lists, comma separated, the choices of effort 8
+// that go back to what effort 7 does. Read at every call, which costs nothing
+// beside an encode.
+
+#ifndef LIB_JXL_RESEARCH_SWITCH_H_
+#define LIB_JXL_RESEARCH_SWITCH_H_
+
+#include <cstdlib>
+#include <cstring>
+
+namespace jxl {
+
+inline bool BackToEffort7(const char* name) {
+  const char* list = std::getenv("JXL_E7");
+  if (list == nullptr) return false;
+  size_t n = std::strlen(name);
+  for (const char* p = list; (p = std::strstr(p, name)) != nullptr; p += n) {
+    if ((p == list || p[-1] == ',') && (p[n] == ',' || p[n] == '\0')) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace jxl
+
+#endif  // LIB_JXL_RESEARCH_SWITCH_H_

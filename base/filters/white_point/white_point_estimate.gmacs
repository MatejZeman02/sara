# Kernels: white_point_estimate
# The sums White Point's Auto estimates the cast from, over one chunk. One
# workgroup of 256 lanes covers the chunk, each lane a stride of texels sixteen
# apart each way, and the lanes fold their sums in shared memory, pairwise as
# reduce.gmacs folds, into one record of eight floats at the slot the push
# constant names. The caller dispatches one chunk at a time and reads every
# record back once, after the last.
#
# Every texel is taken to light-linear sRGB first: an RGB document's curve is
# taken off and its gamut turned by the matrix the caller hands, and an Oklab
# document's coordinates are read back, the matrix then the identity. A texel is
# counted when it holds paint, when its luminance reaches *darkest* (so a black
# background does not steer the estimate), and when no channel of the document's
# own linear RGB reaches *brightest* (so a blown sky does not either). A clipped
# channel is read before the gamut turns, where the clip happened.
#
# The record is two vec4s written as floats, so std430 has nothing to pad:
#   0..2  the surfaces: each counted texel's colour at a luminance of one,
#         times its alpha, so a surface counts by its area and not by its light
#   3     the alpha those colours were weighted by
#   4..6  the edges: the size of each channel's step from a counted texel to
#         its right and lower neighbours, both counted, times the lesser alpha
#   7     the luminance of every counted texel times its alpha
#
# Nothing clamps (hard rule 5). The steps are absolute, so a negative channel
# a wide gamut carries into sRGB adds its size like any other.
#
# SPDX-License-Identifier: GPL-3.0-or-later

kernel white_point_estimate

import oklab_color_space
import transfer_curve

sampler source

# Eight floats a chunk, at the chunk's slot.
buffer records: float values[]

# 80 bytes: the coordinate system, the chunk's edge in texels, the record's
# slot and a spare, the matrix to linear sRGB by column, the document's curve,
# the two thresholds and a spare.
params:
    float coordinates
    float edge
    float slot
    float spare_a
    float to_srgb[9]
    float transfer_slope
    float transfer_threshold
    float transfer_gain
    float transfer_exponent
    float darkest
    float brightest
    float spare_b

const int SA_COORDS_OKLAB = 1
const int SIDE = 16
const uint RECORD = 8u
# The luminance row of linear sRGB, CIE Y.
const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722)

shared vec4 lane_surface[256]
shared vec4 lane_edge[256]


def to_srgb_matrix() -> mat3:
    return mat3(
        to_srgb[0], to_srgb[1], to_srgb[2],
        to_srgb[3], to_srgb[4], to_srgb[5],
        to_srgb[6], to_srgb[7], to_srgb[8])


def document_is_oklab() -> bool: return int(coordinates + 0.5) == SA_COORDS_OKLAB

# Stored *c* in the document's own linear RGB, or for an Oklab document in
# linear sRGB, where its coordinates read back to.


def own_light(vec3 c) -> vec3:
    if document_is_oklab(): return oklab_to_linear_srgb(c)
    return sa_transfer_decode(c, transfer_slope, transfer_threshold, transfer_gain, transfer_exponent)

# The texel at *px* as light-linear sRGB in xyz, and in w its alpha, or a
# negative w when the texel is not counted. A texel that holds no number fails
# every comparison and is not counted either.


def counted_light(ivec2 px) -> vec4:
    vec4 c = texel_fetch(source, px, 0)
    vec3 own = own_light(c.rgb)
    vec3 light = to_srgb_matrix() * own
    bool counted = c.a > 0.0 and max(own.r, max(own.g, own.b)) < brightest and dot(light, LUMA) >= darkest
    return counted ? vec4(light, c.a) : vec4(0.0, 0.0, 0.0, -1.0)

# The size of each channel's step from *here* to the texel at *px*, times the
# lesser alpha, or nothing when that texel is not counted.


def step_to(vec4 here, ivec2 px) -> vec3:
    vec4 there = counted_light(px)
    if there.w < 0.0:
        return vec3(0.0)
    return abs(there.rgb - here.rgb) * min(here.w, there.w)

# The tree over the 256 lanes: each round folds the upper half onto the lower,
# and lane 0 ends holding the chunk's record. Every lane reaches every barrier.


def fold_lanes(uint lane):
    barrier()
    for level in range(8):
        uint width = 128u >> uint(level)
        if lane < width:
            lane_surface[lane] += lane_surface[lane + width]
            lane_edge[lane] += lane_edge[lane + width]
        barrier()


@workgroup_size(16, 16)
def white_point_estimate():
    uint lane = local_index
    int side = int(edge)
    vec4 surface = vec4(0.0)
    vec4 edges = vec4(0.0)
    for y in range(int(local_id.y), side, SIDE):
        for x in range(int(local_id.x), side, SIDE):
            vec4 here = counted_light(ivec2(x, y))
            if here.w < 0.0:
                continue
            float luma = dot(here.rgb, LUMA)
            surface += vec4(here.rgb / luma, 1.0) * here.w
            edges.w += luma * here.w
            if x + 1 < side:
                edges.xyz += step_to(here, ivec2(x + 1, y))
            if y + 1 < side:
                edges.xyz += step_to(here, ivec2(x, y + 1))
    lane_surface[lane] = surface
    lane_edge[lane] = edges
    fold_lanes(lane)
    if lane != 0u:
        return
    uint at = uint(slot) * RECORD
    records.values[at] = lane_surface[0].x
    records.values[at + 1u] = lane_surface[0].y
    records.values[at + 2u] = lane_surface[0].z
    records.values[at + 3u] = lane_surface[0].w
    records.values[at + 4u] = lane_edge[0].x
    records.values[at + 5u] = lane_edge[0].y
    records.values[at + 6u] = lane_edge[0].z
    records.values[at + 7u] = lane_edge[0].w

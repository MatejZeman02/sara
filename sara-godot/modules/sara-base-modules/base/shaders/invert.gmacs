# Kernels: invert
# The invert of the usual set. Every output texel reads only its own input
# texel and rewrites it in place, so this is a point kernel and keeps the
# contract on SaPointPass: the colour field at binding 0, the selection mask at
# binding 1 read per pixel and mixed by, and the dispatched region's origin in
# the push constant.
#
# One minus the colour, over the document's RGB view and written back through
# rgb_to_document, as threshold.gmacs writes its two tones: one minus an Oklab
# triple is a lightness of one minus L with both colour axes turned round and
# offset by one, which a painter sees as a strong tint rather than the
# opposite colour. Alpha is kept. Nothing clamps, so a colour past
# white comes out below black and a second invert brings it back.
#
# The helpers are threshold.gmacs's, repeated because a .gmacs block cannot be
# shared between files without sharing the push constant that names it.
#
# SPDX-License-Identifier: GPL-3.0-or-later

kernel invert

import linear_srgb_color_space
import transfer_curve

image canvas
# The document-wide selection, as in adjust.gmacs: a 1 by 1 mask reads as 1.0
# everywhere through the clamped read (core/api/selection/sa_selection.gd).
image mask: r32f, readonly

# 112 bytes: the region's origin, two spares, then the colour space tail
# exactly as SaColorSpacePushConstant writes it. The spares keep the tail on
# the four-float boundary it starts at in threshold.gmacs.
params:
    float origin_x  # the dispatched region's origin in the chunk, in pixels
    float origin_y  # zero for the destructive pass, which covers the chunk
    float spare_a
    float spare_b
    float doc_to_linear_srgb[9]
    float linear_srgb_to_doc[9]
    float transfer_slope
    float transfer_threshold
    float transfer_gain
    float transfer_exponent
    float coordinates


def to_linear_srgb_matrix() -> mat3:
    return mat3(
        doc_to_linear_srgb[0], doc_to_linear_srgb[1], doc_to_linear_srgb[2],
        doc_to_linear_srgb[3], doc_to_linear_srgb[4], doc_to_linear_srgb[5],
        doc_to_linear_srgb[6], doc_to_linear_srgb[7], doc_to_linear_srgb[8])


def from_linear_srgb_matrix() -> mat3:
    return mat3(
        linear_srgb_to_doc[0], linear_srgb_to_doc[1], linear_srgb_to_doc[2],
        linear_srgb_to_doc[3], linear_srgb_to_doc[4], linear_srgb_to_doc[5],
        linear_srgb_to_doc[6], linear_srgb_to_doc[7], linear_srgb_to_doc[8])


def document_to_linear(vec3 c) -> vec3:
    return sa_transfer_decode(c, transfer_slope, transfer_threshold, transfer_gain, transfer_exponent)


def linear_to_document(vec3 c) -> vec3:
    return sa_transfer_encode(c, transfer_slope, transfer_threshold, transfer_gain, transfer_exponent)

const int SA_COORDS_OKLAB = 1


def document_is_oklab() -> bool: return int(coordinates + 0.5) == SA_COORDS_OKLAB


def document_to_rgb(vec3 c) -> vec3:
    if not document_is_oklab(): return c
    return linear_to_document(from_linear_srgb_matrix() * oklab_to_linear_srgb(c))


def rgb_to_document(vec3 c) -> vec3:
    if not document_is_oklab(): return c
    return linear_srgb_to_oklab(to_linear_srgb_matrix() * document_to_linear(c))


def coverage_at(ivec2 px) -> float:
    return mask[min(px, image_size(mask) - 1)].r


def invert():
    ivec2 px = ivec2(global_id.xy) + ivec2(int(origin_x), int(origin_y))
    ivec2 size = image_size(canvas)
    if px.x >= size.x or px.y >= size.y:
        return
    vec4 c = canvas[px]
    vec3 turned = rgb_to_document(vec3(1.0) - document_to_rgb(c.rgb))
    canvas[px] = vec4(mix(c.rgb, turned, coverage_at(px)), c.a)

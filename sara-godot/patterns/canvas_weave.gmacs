# Canvas weave, the second shipped pattern.
#
# Warp and weft as two crossed sinusoids, a whole number of threads per tile
# so the weave wraps at the edge, and the deeper of the two hollows between
# threads is where the dab paints least. One is the top of a thread and the
# pattern never reaches nought, because a canvas takes some paint everywhere.
#
# `tile` is written by the store from the texture's own width. `threads` is
# how many threads cross one tile and `depth` is how far the hollows drop.
#
# SPDX-License-Identifier: GPL-3.0-or-later

uniform float tile: hint_range(1, 4096) = 256.0
uniform int threads: hint_range(2, 64) = 12
uniform float depth: hint_range(0, 1) = 0.5

const float SA_WEAVE_TAU = 6.28318530717958647692


def pixel(ivec2 at) -> vec4:
    vec2 p = vec2(at) * float(threads) * SA_WEAVE_TAU / tile
    float warp = 0.5 + 0.5 * sin(p.x)
    float weft = 0.5 + 0.5 * sin(p.y)
    float thread = max(warp, weft)
    float value = 1.0 - depth * (1.0 - thread)
    return vec4(value, value, value, 1.0)

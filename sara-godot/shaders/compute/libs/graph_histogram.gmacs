# The histogram: which rows it draws, what it divides them by, and the picture
# it makes of them.
#
# This is a library of its own, not part of graph.gmacs.
# The line between them is the mode: every other scope in the kernel reads
# the counts a different way and none of them reads these, so the histogram's
# rows, its normaliser and its drawing are one thing that changes together and
# nothing else changes with them. Included after the counts buffer, the push
# constant and `flag_set`, which is where a library that reads bindings has to
# sit.
#
# `draw_histogram` is called from `graph_draw`'s mode chain and is the only
# name here that anything outside this file uses.
#
# Levels and Curves draw it as bars. A painted layer holds a
# few levels, each a bin one texel wide, and a 256 texel picture stretched
# across a dialog drew each as a column one or two pixels wide, which is what
# the painter called a few thin spikes. So the two ask for a reach, below, and
# every bin is drawn as the tallest within that many bins either side of it:
# a lone level becomes a bar at least three logical pixels wide, with an
# outline at full strength and a faint fill under it. The Graph docker asks
# for none and keeps its own picture.

# How much of the histogram's height its busiest bin fills.
const float HIST_TOP = 0.92

# Which rows of the histogram are drawn, and therefore what its count axis is
#   normalised against.
#
# Zero is the Graph docker's own: the three channel rows overlaid at
#   half strength, darktable's scope, with the count axis against the largest
#   bin of all four rows. The luma row is one of those four and nothing draws
#   it, so on paint whose luma piles into a bin no channel reaches, the three
#   curves on screen are scaled down by a bin that is not on screen.
#
# The Levels dialog sets one of these instead, because its Channel dropdown
#   has to mean something and a painter reading levels off the graph is
#   reading the row they are about to move. Only the chosen rows are drawn,
#   and only their own bins normalise, which is what `ROW_MAX_SLOT` is for.
const int FLAG_ROW_R = 4
const int FLAG_ROW_G = 8
const int FLAG_ROW_B = 16
const int FLAG_ROW_LUMA = 32
# The four together, and the three colour rows without the luma one, which is
#   what a zero selection falls back to.
const int FLAG_ROWS = 60
const int FLAG_ROWS_RGB = 28

# The histogram's count axis: darktable's log, or the plain ratio on the
#   toggle, and the busiest bin stops short of the top so the curve has a top.


def hist_level(uint index, float largest) -> float:
    float count = float(counts.values[index])
    if flag_set(FLAG_LINEAR):
        return count / largest * HIST_TOP
    return log(1.0 + count) / log(1.0 + largest) * HIST_TOP

# darktable's grid behind a histogram: four divisions each way, one texel
#   wide, dim.


def grid_lines(vec2 texel) -> vec3:
    vec2 unit = (texel + 0.5) / plot_size()
    vec2 away = abs(unit * 4.0 - round(unit * 4.0)) / 4.0 * plot_size()
    float line = max(1.0 - smoothstep(0.3, 1.3, away.x), 1.0 - smoothstep(0.3, 1.3, away.y))
    return vec3(line * 0.14)

# Which histogram rows this pass draws, with zero meaning the docker's three.


def chosen_rows() -> int:
    int chosen = int(flags + 0.5) & FLAG_ROWS
    if chosen == 0:
        return FLAG_ROWS_RGB
    return chosen

# The count axis's top: the largest bin among the rows actually drawn, or the
#   maximum over every row when nothing was chosen, which is what the docker
#   has always divided by.


def hist_top(float largest) -> float:
    if (int(flags + 0.5) & FLAG_ROWS) == 0:
        return largest
    int chosen = chosen_rows()
    float most = 1.0
    if (chosen & FLAG_ROW_R) != 0:
        most = max(most, float(counts.values[ROW_MAX_SLOT]))
    if (chosen & FLAG_ROW_G) != 0:
        most = max(most, float(counts.values[ROW_MAX_SLOT + 1u]))
    if (chosen & FLAG_ROW_B) != 0:
        most = max(most, float(counts.values[ROW_MAX_SLOT + 2u]))
    if (chosen & FLAG_ROW_LUMA) != 0:
        most = max(most, float(counts.values[ROW_MAX_SLOT + 3u]))
    return most

# How strongly one row's fill is drawn: half where rows are overlaid, whole
#   where one row is alone. Half is darktable's ADD at an alpha of a half, and
#   it is what says which channels agree. A single channel has nothing to
#   agree with, and Levels showing one is a solid curve rather than a dim one.


def hist_strength() -> float:
    int chosen = chosen_rows()
    if chosen == FLAG_ROW_R or chosen == FLAG_ROW_G or chosen == FLAG_ROW_B or chosen == FLAG_ROW_LUMA:
        return 1.0
    return 0.5

# The bars' reach: how many bins either side of its own a bin's bar spreads
#   over, in bits 8 to 11 of the flags word, above every flag. Nought is the
#   docker's picture, a column a bin. `SaGraphPlot.bar_reach_for` works it
#   out from the width the picture is shown at.
const int BAR_SHIFT = 8
const int BAR_MASK = 15
# How strongly the area under a bar is filled, against its outline at full
#   strength.
const float BAR_FILL = 0.35


def bar_reach() -> int:
    return (int(flags + 0.5) >> BAR_SHIFT) & BAR_MASK

# The bin the texel column at *x* stands over in the bars' picture. Every bin
#   takes an equal share of the width, so the last one, pure white, has a
#   column of its own: the docker's rounding leaves it none at 256 texels.


def bar_bin(float x) -> int:
    return clamp(int((x + 0.5) / plot_size().x * float(BINS)), 0, int(BINS) - 1)

# How tall one row stands over the texel column at *x*: its tallest bin
#   within the reach.


def bar_level(uint row, float x, float top) -> float:
    int centre = bar_bin(x)
    int reach = bar_reach()
    float most = 0.0
    for b in range_inclusive(max(centre - reach, 0), min(centre + reach, int(BINS) - 1)):
        most = max(most, hist_level(row * BINS + uint(b), top))
    return most

# How much of one row the texel at *texel* shows as a bar: the outline at
#   full strength, a texel thick along the top and both sides, the area under
#   it at BAR_FILL, and nothing above it.


def bar_share(uint row, vec2 texel, float top) -> float:
    float height = 1.0 - (texel.y + 0.5) / plot_size().y
    float level = bar_level(row, texel.x, top)
    if height > level:
        return 0.0
    bool edge = height > level - 1.0 / plot_size().y
    edge = edge or height > bar_level(row, texel.x - 1.0, top) or height > bar_level(row, texel.x + 1.0, top)
    return edge ? 1.0 : BAR_FILL


def draw_histogram(vec2 texel, float largest) -> vec3:
    uint bin = uint(texel.x / plot_size().x * float(BINS - 1u) + 0.5)
    float height = 1.0 - (texel.y + 0.5) / plot_size().y
    vec3 colour = grid_lines(texel)
    int chosen = chosen_rows()
    float top = hist_top(largest)
    float strength = hist_strength()
    bool bars = bar_reach() > 0
    const ivec3 ROW_BITS = ivec3(FLAG_ROW_R, FLAG_ROW_G, FLAG_ROW_B)
    for c in range(3):
        if (chosen & ROW_BITS[c]) == 0:
            continue
        vec3 channel = vec3(0.0)
        channel[c] = 1.0
        float share = bars ? bar_share(uint(c), texel, top) : step(height, hist_level(uint(c) * BINS + bin, top))
        colour += channel * strength * share
    # The luma row, which nothing drew until Levels grew a Lightness channel
    #       to ask for it. Grey, because it is not a channel of the picture.
    if (chosen & FLAG_ROW_LUMA) != 0:
        float share = bars ? bar_share(3u, texel, top) : step(height, hist_level(3u * BINS + bin, top))
        colour += vec3(strength) * share
    return colour

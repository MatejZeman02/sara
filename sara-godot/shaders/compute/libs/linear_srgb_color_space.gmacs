# Library: Gamma correction utilities.
# Handles the conversion between standard sRGB (pickers) and Linear sRGB (math).
# Ensures light-linear blending to avoid dark fringe artifacts.
# Library to connect the color spaces via the linear srgb color space as an intermediate.
# This allows switching between color spaces on the fly.

import oklab_color_space

# Apply a simple gamma correction


def gamma(vec3 c, float gamma) -> vec3:
    return pow(c, vec3(gamma))

# The sRGB transfer curve is defined on [0, 1], but Sara's canvas is float and
# must carry values outside it, negatives included. Both directions are
# therefore mirrored through the origin: the sign is carried separately and the
# standard piecewise curve is applied to the magnitude.
#
# This is not cosmetic. `pow` of a negative base is undefined, and GLSL's mix()
# evaluates both arms, so the unmirrored form returns NaN for any negative
# channel, and NaN * 0.0 is NaN, not 0.0. A clamp afterwards would hide it,
# because clamp() launders NaN into a bound, and gamut mapping clamps nothing.
#
# Values in [0, 1] are unaffected: sign is 1 and abs is the identity there.

# Apply sRGB gamma correction


def linear_srgb_to_srgb(vec3 c) -> vec3:
    vec3 magnitude = abs(c)
    vec3 srgb = mix(
    12.92 * magnitude,
    1.055 * pow(magnitude, vec3(1.0 / 2.4)) - 0.055,
    step(0.0031308, magnitude)
    )
    return sign(c) * srgb

# Apply inverse sRGB gamma correction


def srgb_to_linear_srgb(vec3 c) -> vec3:
    vec3 magnitude = abs(c)
    vec3 linear_srgb = mix(
    magnitude / 12.92,
    pow((magnitude + 0.055) / 1.055, vec3(2.4)),
    step(0.04045, magnitude)
    )
    return sign(c) * linear_srgb

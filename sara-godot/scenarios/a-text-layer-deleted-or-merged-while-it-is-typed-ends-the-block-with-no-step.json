[
 {
  "comment": "A fresh block deleted from the Layers docker while it is typed ends with no step, keys typed after do nothing, and undo brings the layer back where it was deleted from."
 },
 {
  "wait": 60
 },
 {
  "prefs": {
   "ui_scale": 1.0,
   "autosave_interval_minutes": 0
  }
 },
 {
  "wait": 10
 },
 {
  "document": "srgb",
  "size": [
   800,
   400
  ]
 },
 {
  "wait": 10
 },
 {
  "fit": true
 },
 {
  "fill": [
   0.9,
   0.9,
   0.85
  ]
 },
 {
  "layer": {

[
  {"comment": "A detour tool's shortcut pressed again goes back to the tool before it. From the Brush, Ctrl+T picks the Transform, a selection is lifted and moved, and Ctrl+T again hands the Brush back with the lift put back and no step written. The same with C and a pending crop. Then every detour's chord twice from the Brush, Zoom on a chord of its own since it ships with none, and B twice. Last, the Transform rebound to Ctrl+Alt+K on the Keyboard Shortcuts page, where Ctrl+T picks nothing and Ctrl+Alt+K toggles. Every key line in run.log names the tool in hand after it. Nothing is saved."},
  {"wait": 45},
  {"window": [1920, 1080]},
  {"prefs": {"ui_scale": 1.0}},
  {"wait": 20},
  {"document": "srgb"},
  {"wait": 25},
  {"docker": "park"},
  {"wait": 20},
  {"layer": {"add": "Paint", "fill": [0.25, 0.45, 0.7, 1.0]}},
  {"wait": 10},
  {"tool": "brush"},
  {"wait": 5},
  {"select": [300, 200, 200, 150]},
  {"wait": 10},
  {"texel": [[350, 250], [700, 250], [100, 100]]},
  {"state": "00-the-brush-and-a-selection"},

  {"comment": "01, Ctrl+T picks the Transform, its box the selection's."},
  {"key": {"key": "t", "ctrl": true}},
  {"wait": 15},
  {"state": "01-ctrl-t-picks-the-transform"},
  {"shot": "01-ctrl-t-picks-the-transform"},

  {"comment": "02, the selection lifted and moved 300 to the right, a hole where it was and no step yet."},
  {"transform": {"from": [400, 275], "to": [700, 275]}},
  {"wait": 15},
  {"texel": [[350, 250], [700, 250], [100, 100]]},
  {"state": "02-the-selection-moved"},
  {"shot": "02-the-selection-moved"},

  {"comment": "03, Ctrl+T again: the Brush is back, the lift put back, and the history as it was."},
  {"key": {"key": "t", "ctrl": true}},
  {"wait": 15},
  {"texel": [[350, 250], [700, 250], [100, 100]]},
  {"state": "03-ctrl-t-again-hands-the-brush-back"},
  {"shot": "03-ctrl-t-again-hands-the-brush-back"},

  {"comment": "04, C picks the Crop and a box is dragged, the layer shown cropped to it."},
  {"select": "none"},
  {"wait": 5},
  {"key": {"key": "c"}},
  {"wait": 10},
  {"crop": {"from": [200, 150], "to": [900, 600]}},

[
  {"comment": "A group of a Curves layer and a Hue, Saturation and Lightness layer over a painted layer, the second switched off, saved as Warm with the Looks part's Save Look... and the name typed and kept with Return, the group deleted, Warm picked and added back with Add, and the canvas read at the same points before the delete and after the add. Then Warm is renamed Warmer and deleted, so the part's list is read through all four buttons."},
  {"wait": 45},
  {"prefs": {"ui_scale": 1.0}},
  {"wait": 20},
  {"document": "srgb"},
  {"wait": 25},
  {"layer": {"add": "Paint", "fill": [0.25, 0.45, 0.7, 1.0]}},
  {"wait": 10},
  {"colour": [0.85, 0.7, 0.25]},
  {"wait": 5},
  {"stroke": {"from": [600, 420], "to": [1350, 420], "pressure": 1.0}},
  {"wait": 15},

  {"layer": {"add": "Curves", "type": "adjustment"}},
  {"filter_rows": {"attach": "sara-base-modules.curves", "layer": "Curves", "params": {"curves": {"master": [[0.0, 0.0], [0.5, 0.66], [1.0, 1.0]], "red": [[0.0, 0.1], [1.0, 1.0]]}}}},
  {"wait": 10},
  {"layer": {"add": "Hue Saturation Lightness", "type": "adjustment"}},
  {"filter_rows": {"attach": "sara-base-modules.hue_saturation_lightness", "layer": "Hue Saturation Lightness", "params": {"hue": 25.0, "saturation": 150.0, "lightness": 0.0}}},
  {"wait": 10},
  {"layer": {"of": "Hue Saturation Lightness", "visible": false}},
  {"pick_rows": [0, 1]},
  {"layer_action": "group"},
  {"wait": 25},
  {"filter_browser": "open"},
  {"wait": 25},
  {"wheel": {"at": [1520, 1000], "notches": -10, "read": true}},
  {"wait": 10},
  {"texel": [[960, 300], [960, 420], [700, 600]]},
  {"shot": "1-the-group-of-two-filter-layers-the-second-off"},
  {"state": "1-the-group-of-two-filter-layers-the-second-off"},

  {"click": {"control": "LookSave"}},
  {"wait": 10},
  {"control": {"name": "LookName", "value": "Warm"}},
  {"key": "enter"},
  {"wait": 15},
  {"filter_browser": "describe"},
  {"shot": "2-saved-as-warm"},

  {"pick_rows": [0]},
  {"layer_action": "delete"},
  {"wait": 25},
  {"texel": [[960, 300], [960, 420], [700, 600]]},
  {"shot": "3-the-group-deleted"},

  {"filter_browser": {"look": "Warm"}},
  {"click": {"control": "LookAdd"}},
  {"wait": 30},
  {"texel": [[960, 300], [960, 420], [700, 600]]},
  {"filter_browser": "describe"},
  {"shot": "4-warm-added-back-two-members-in-order-the-second-off"},
  {"state": "4-warm-added-back-two-members-in-order-the-second-off"},

  {"click": {"control": "LookRename"}},
  {"wait": 10},
  {"control": {"name": "LookName", "value": "Warmer"}},
  {"key": "enter"},
  {"wait": 15},
  {"filter_browser": "describe"},
  {"click": {"control": "LookDelete"}},
  {"wait": 15},
  {"answer": 1},
  {"wait": 15},
  {"filter_browser": "describe"},
  {"shot": "5-renamed-and-deleted"},

  {"layer": {"activate": "Paint"}},
  {"click": {"control": "LookSave"}},
  {"wait": 15},
  {"filter_browser": "describe"},
  {"shot": "6-save-look-on-a-paint-layer-is-refused"}

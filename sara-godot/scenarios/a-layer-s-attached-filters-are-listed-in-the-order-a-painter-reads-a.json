[
  {"comment": "Levels and then Curves attached to a painted layer, listed with Curves above Levels. Levels is then dragged by a real press above Curves, which makes it run last, and the composite is read before and after with the texel step. One Ctrl+Z puts the order and the picture back."},
  {"wait": 45},
  {"prefs": {"ui_scale": 1.0}},
  {"wait": 20},
  {"layer": {"add": "Paint", "fill": [0.55, 0.4, 0.3, 1.0]}},
  {"wait": 10},
  {"docker": {"id": "LayersDocker", "at": [620, 180], "size": [420, 460]}},
  {"docker": {"id": "UndoDocker", "at": [1060, 180], "size": [340, 340]}},
  {"wait": 15},
  {"texel": [[1500, 800]]},
  {"shot": "0-before-any-filter"},
  {"filter_rows": {"attach": "sara-base-modules.levels", "layer": "Paint", "params": {"in_black": 0.3, "gamma": 1.6, "in_white": 0.85, "out_black": 0.05, "out_white": 0.95, "channel": "master"}}},
  {"wait": 10},
  {"filter_rows": {"attach": "sara-base-modules.curves", "layer": "Paint", "params": {"curves": {"master": [[0.0, 0.0], [0.375, 0.75], [1.0, 1.0]], "blue": [[0.0, 0.25], [1.0, 0.75]]}}}},
  {"wait": 20},
  {"filter_rows": ""},
  {"texel": [[1500, 800]]},
  {"shot": "1-levels-then-curves-curves-is-listed-above"},
  {"state": "1-levels-then-curves-curves-is-listed-above"},

  {"press": {"button": "left", "at": [830, 301]}},
  {"move": [830, 293]},
  {"move": [830, 280]},
  {"move": [830, 268]},
  {"move": [830, 262]},
  {"shot": "2-levels-dragged-over-the-top-half-of-curves"},
  {"release": {"button": "left", "at": [830, 262]}},
  {"wait": 20},
  {"filter_rows": ""},
  {"move": [10, 10]},
  {"texel": [[1500, 800]]},
  {"shot": "3-levels-runs-last-and-is-listed-on-top"},
  {"state": "3-levels-runs-last-and-is-listed-on-top"},

  {"key": {"key": "z", "ctrl": true}},
  {"wait": 20},
  {"filter_rows": ""},
  {"texel": [[1500, 800]]},
  {"shot": "4-one-undo-puts-curves-on-top-again"},
  {"state": "4-one-undo-puts-curves-on-top-again"}
]

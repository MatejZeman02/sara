[
  {"comment": "A soft stroke on a transparent page, blurred by Box Blur at radii 1, 3 and 20 through its dialog and Apply, each result read off the layer as a .npy and photographed, then undone. Run once on the old kernel and once on the pixel function, and the two runs' files compared."},
  {"wait": 45},
  {"prefs": {"ui_scale": 1.0}},
  {"wait": 20},
  {"document": "srgb", "background": {"kind": "transparent"}, "size": [640, 384]},
  {"wait": 25},
  {"docker": "park"},
  {"wait": 20},
  {"colour": [0.9, 0.35, 0.1]},
  {"wait": 5},
  {"brush": {"radius_px": 28, "opacity": 1.0}},
  {"wait": 5},
  {"stroke": {"space": "document", "from": [60, 120], "to": [580, 260], "pressure": 1.0, "steps": 30}},
  {"wait": 20},
  {"read_pixels": {"rect": [0, 0, 640, 384], "file": "r0-the-soft-stroke.npy"}},

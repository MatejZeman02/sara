[
  {"comment": "A document of 1920 by 1280 with the harness's photograph imported as a layer the size of the canvas, fitted. The middle of the photograph, document (480, 320) to (1440, 960), three to two, is selected and the Transform picked under Normal. Its right side handle, at document (1440, 640), is dragged 240 to the right with Shift held, which keeps three to two: 1200 by 800, the left side at 480 and the middle line at 640. Cancelled, the same drag with Ctrl leans the box over, and cancelled again, the drag with neither stretches the photograph to 1200 by 640."},
  {"wait": 45},
  {"docker": "park"},
  {"prefs": {"ui_scale": 1.0}},
  {"wait": 20},
  {"document": "srgb", "size": [1920, 1280]},
  {"wait": 25},
  {"import": "res://scenarios/references/a-photograph.jpg"},
  {"wait": 30},
  {"fit": true},
  {"wait": 10},
  {"layer": {"activate": "a-photograph"}},
  {"wait": 5},
  {"select": [480, 320, 960, 640]},
  {"wait": 5},
  {"tool": {"id": "transform", "options": {"transform_mode": 0}}},
  {"wait": 10},
  {"state": "1-three-to-two-at-rest"},
  {"shot": "1-three-to-two-at-rest"},

  {"key": {"key": "shift", "pressed": true}},
  {"transform": {"from": [1440, 640], "to": [1680, 640], "shift": true, "steps": 12}},
  {"key": {"key": "shift", "pressed": false}},
  {"wait": 10},
  {"state": "2-shift-on-the-side-keeps-three-to-two"},
  {"shot": "2-shift-on-the-side-keeps-three-to-two"},
  {"transform": {"cancel": true}},
  {"wait": 10},

  {"key": {"key": "ctrl", "pressed": true}},
  {"transform": {"from": [1440, 640], "to": [1440, 800], "ctrl": true, "steps": 12}},
  {"key": {"key": "ctrl", "pressed": false}},
  {"wait": 10},
  {"state": "3-ctrl-on-the-side-shears"},
  {"shot": "3-ctrl-on-the-side-shears"},
  {"transform": {"cancel": true}},
  {"wait": 10},

  {"transform": {"from": [1440, 640], "to": [1680, 640], "steps": 12}},
  {"wait": 10},
  {"state": "4-neither-stretches-the-one-axis"},
  {"shot": "4-neither-stretches-the-one-axis"},
  {"key": "escape"},
  {"wait": 8}
]

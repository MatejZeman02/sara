[
  {"modules_on": ["kaleidoscope"]},
  {"timeout": 900},
  {"comment": "The every usual filter clause of the session, kept in step with the filter dialog and the Filter menu by section. One test picture, then for each filter of group C and the kaleidoscope, its dialog opened by its registry key, applied at the dialog's defaults and shot, undone with Ctrl+Z, then the dialog opened again with its Attach box ticked, applied and shot at the defaults a record starts with, and undone again. The texels are read on the orange stroke, beside it on the blue ground and on the dark line, the same three for every filter. The Filter menu is shot once, before the first filter, so the sections it now draws are on the record. The layers docker sits inside 1280 by 1024, so the file runs unchanged on any screen."},
  {"wait": 45},
  {"prefs": {"ui_scale": 1.0}},
  {"wait": 20},
  {"document": "srgb"},
  {"wait": 25},
  {"docker": "park"},
  {"docker": {"id": "LayersDocker", "at": [860, 120], "size": [400, 300]}},
  {"wait": 20},
  {"layer": {"add": "Paint", "fill": [0.25, 0.45, 0.7, 1.0]}},
  {"wait": 10},
  {"colour": [0.95, 0.55, 0.15]},
  {"wait": 5},
  {"stroke": {"from": [250, 250], "to": [1100, 750], "pressure": 1.0}},
  {"colour": [0.1, 0.1, 0.1]},
  {"wait": 5},
  {"stroke": {"from": [250, 500], "to": [1100, 500], "pressure": 1.0}},
  {"colour": [0.95, 0.95, 0.9]},
  {"wait": 5},
  {"stroke": {"from": [700, 200], "to": [700, 850], "pressure": 0.5}},
  {"wait": 15},
  {"texel": [[600, 480], [400, 700], [600, 500]]},
  {"shot": "00-the-test-picture"},
  {"menu": "Filter"},
  {"wait": 15},
  {"shot": "00-the-filter-menu-in-sections"},
  {"key": "escape"},
  {"wait": 10},

  {"filter": {"open": "sara-base-modules.gaussian_blur"}},

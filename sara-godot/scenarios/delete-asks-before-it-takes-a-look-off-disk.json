[
  {"comment": "Delete in the Filters docker's Looks part asks before it takes a look off disk. A group of two filter layers is saved as Warm, Warm is picked and Delete pressed, and the question naming Warm stands beside the docker with the look still listed. Cancel keeps it, and Delete on the question takes it off the list."},
  {"wait": 45},
  {"prefs": {"ui_scale": 1.0}},
  {"wait": 20},
  {"document": "srgb"},
  {"wait": 25},
  {"layer": {"add": "Paint", "fill": [0.25, 0.45, 0.7, 1.0]}},
  {"wait": 10},
  {"colour": [0.85, 0.7, 0.25]},
  {"wait": 5},
  {"stroke": {"from": [600, 420], "to": [1350, 420], "pressure": 1.0}},
  {"wait": 15},

  {"layer": {"add": "Curves", "type": "adjustment"}},
  {"filter_rows": {"attach": "sara-base-modules.curves", "layer": "Curves", "params": {"curves": {"master": [[0.0, 0.0], [0.5, 0.66], [1.0, 1.0]], "red": [[0.0, 0.1], [1.0, 1.0]]}}}},
  {"wait": 10},
  {"layer": {"add": "Hue Saturation Lightness", "type": "adjustment"}},
  {"filter_rows": {"attach": "sara-base-modules.hue_saturation_lightness", "layer": "Hue Saturation Lightness", "params": {"hue": 25.0, "saturation": 150.0, "lightness": 0.0}}},
  {"wait": 10},
  {"layer": {"of": "Hue Saturation Lightness", "visible": false}},
  {"pick_rows": [0, 1]},
  {"layer_action": "group"},
  {"wait": 25},
  {"filter_browser": "open"},
  {"wait": 25},
  {"wheel": {"at": [1520, 1000], "notches": -10, "read": true}},
  {"wait": 10},
  {"texel": [[960, 300], [960, 420], [700, 600]]},

  {"click": {"control": "LookSave"}},
  {"wait": 10},
  {"control": {"name": "LookName", "value": "Warm"}},
  {"key": "enter"},
  {"wait": 15},
  {"filter_browser": "describe"},
  {"shot": "1-warm-saved-and-listed"},

  {"filter_browser": {"look": "Warm"}},
  {"click": {"control": "LookDelete"}},
  {"wait": 20},
  {"filter_browser": "describe"},
  {"shot": "2-delete-asks-naming-warm-beside-the-docker"},
  {"state": "2-delete-asks-naming-warm-beside-the-docker"},

  {"answer": 0},
  {"wait": 20},
  {"filter_browser": "describe"},
  {"shot": "3-cancel-keeps-warm"},

  {"filter_browser": {"look": "Warm"}},
  {"click": {"control": "LookDelete"}},
  {"wait": 20},
  {"answer": 1},
  {"wait": 20},
  {"filter_browser": "describe"},
  {"shot": "4-delete-on-the-question-takes-warm-off"},
  {"state": "4-delete-on-the-question-takes-warm-off"}
]

msgstr[2] "%d vět"

# The top bar page's readout, whose counts go through tr_n() since T4, so a
# scenario shows a count in each of Czech's three forms.
msgid "%d control is in the overflow list, behind the button at the end of the bar."
msgid_plural "%d controls are in the overflow list, behind the button at the end of the bar."
msgstr[0] "%d ovládací prvek je v seznamu přetečení, za tlačítkem na konci lišty."
msgstr[1] "%d ovládací prvky jsou v seznamu přetečení, za tlačítkem na konci lišty."
msgstr[2] "%d ovládacích prvků je v seznamu přetečení, za tlačítkem na konci lišty."

msgid "The window is %d pixel too narrow for one row, so the second row stays."
msgid_plural "The window is %d pixels too narrow for one row, so the second row stays."
msgstr[0] "Okno je o %d pixel příliš úzké pro jednu řadu, a tak druhá řada zůstává."

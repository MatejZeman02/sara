# The language fixture's catalogue, Czech.
#
# SPDX-License-Identifier: GPL-3.0-or-later
#
# It translates the Languages page's own words and the top bar's menu names,
# enough for a suite to read a sentence through tr() and for a scenario's shot
# to show the page in Czech. T3 added every docker's title, the File and
# Window menus' rows and the toolbox's tool names, so a shot shows the dockers
# and the menus follow the locale too. It is a fixture and not Sara's Czech,
# which is a module of its own.
msgid ""
msgstr ""
"Language: cs\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n==1) ? 0 : (n>=2 && n<=4) ? 1 : 2;\n"

msgid "Languages"
msgstr "Jazyky"

msgid "Language"
msgstr "Jazyk"

msgid "The language Sara's windows speak. It switches at once, with no restart."
msgstr "Jazyk, kterým mluví okna Sary. Přepne se hned, bez restartu."

msgid "English"
msgstr "Angličtina"

msgid "Czech"
msgstr "Čeština"


## The learned cursor lead's weights.
##
## Generated by scripts/train_cursor_lead.py from recorded pen strokes, and
## never edited by hand. One row per horizon: the x weights over the last TAPS displacements, x then y each,
## followed by the x bias, then the same for y. `SaCursorPrediction.learned_lead`
## reads the two rows around the horizon it is asked for and interpolates.
##
## Held-out rms distance from the pen, in logical pixels, on the recording it
## was fitted from:
##    8 ms: linear 4.05, window fit 6.76, constant velocity 6.58, hold 6.81
##   16 ms: linear 5.95, window fit 12.50, constant velocity 9.20, hold 11.95
##   33 ms: linear 13.01, window fit 27.21, constant velocity 19.71, hold 23.04
##   50 ms: linear 21.40, window fit 43.41, constant velocity 32.86, hold 33.24
##
## Regenerate with:  python3 scripts/train_cursor_lead.py
class_name SaCursorLeadWeights
extends RefCounted

## The even grid the displacements are read on, in hertz.
const GRID_HZ: float = 120.0

## How many displacements before the newest reading feed a row.
const TAPS: int = 4

## The inputs a row reads, in the order its weights stand.
const INPUTS: Array = ["displacements"]

## What the weights were fitted from.
const TRAINED_ON: String = "907 strokes from 1 recording(s), 2026-09-14"

## The horizons a row was fitted for, in milliseconds, ascending.

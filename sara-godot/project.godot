; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Sara"
config/description="A painting program that paints on the graphics card, in floating point colour."
config/version="1.0.0-alpha.1"
run/main_scene="uid://c7ujfj865uuwj"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=100
run/low_processor_mode=true
boot_splash/bg_color=Color(0.12549, 0.141176, 0.129412, 1)
boot_splash/show_image=false
config/icon="uid://cwb1h56ls8u81"
config/quit_on_go_back=false

[audio]

driver/enable_input=true
buses/default_bus_layout="res://geditor/default_bus_layout.tres"

[autoload]

SaRunLog="*res://core/app/sa_run_log.gd"
SaBackgroundStart="*res://ui/boot/sa_background_start.gd"
GlobalShaderCompiler="*res://core/custom-shader/compiler/global_shader_compiler.gd"
EventBus="*res://core/api/event_bus.gd"
ModuleLoader="*res://core/loader/module_loader.gd"
SaSettings="*res://core/settings/sa_settings.gd"
SaSettingsApply="*res://ui/settings/sa_settings_apply.gd"
SaColors="*res://core/colors/sa_color_store.gd"
SaIdle="*res://core/idle/sa_idle_clock.gd"
SaReductions="*res://core/api/reduction/sa_reduction_service.gd"

[debug]

settings/gdscript/always_track_call_stacks=true
gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1
file_logging/enable_file_logging.pc=false
file_logging/max_log_files=10

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/size/mode.android=3
window/size/borderless=true
window/size/extend_to_title=true
window/size/sharp_corners=true
window/handheld/orientation=6
window/energy_saving/keep_screen_on=false
window/stretch/aspect="ignore"
window/frame_pacing/android/enable_frame_pacing=false
display_server/driver.linuxbsd="wayland"

[editor]

run/main_run_args="--display-driver wayland"
import/use_multiple_threads=false

[gui]

theme/custom="res://ui/themes/teal-orange.tres"


[input_devices]

buffering/agile_event_flushing=true
pen_tablet/driver.windows="wintab"
pointing/android/disable_scroll_deadzone=true

[internationalization]

locale/fallback="en_GB"

[memory]

limits/message_queue/max_size_mb=128

[rendering]

rendering_device/vsync/swapchain_image_count=2
textures/vram_compression/import_etc2_astc=true

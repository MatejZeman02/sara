msgid "Proofs"
msgstr ""

#: ui/settings/look/display_page.gd:821
msgid "Canvas proof"
msgstr ""

#: ui/settings/look/display_page.gd:822
msgid "What Ctrl+Y shows on the canvas. A proof already on screen follows this at once."
msgstr ""

#: ui/settings/look/display_page.gd:827
#: ui/shortcuts/shortcut_commands.gd:216

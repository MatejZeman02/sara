#: modules/sara-base-modules/stamp-brush/presets/sa_author_presets.gd:27
msgid "Sara author"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_author_presets.gd:55
msgid "Torn Gouache"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_author_presets.gd:60
msgid "A dense ribbon of opaque paint with a ragged torn edge, built up dab on dab, a painter's own brush. It paints in a mixing blend mode where a mixing module is installed, so over another colour it mixes as paint does, blue over yellow turning green."
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:44
msgid "Sara drawn"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:109
msgid "Torn Block"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:112
msgid "A block of flat colour with a torn edge, turned at random each dab so the edge never repeats."
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:132
msgid "Smoky Blot"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:135
msgid "A smoky blot of uneven darkness, for clouds of colour and soft shadows."
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:154
msgid "Storm Cloud"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:157
msgid "A cloud mass with light veins through it, for skies, smoke and foam."
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:177
msgid "Scrawled Block"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:180
msgid "A dense block of scrawled strokes, for rough fills that read as drawn."
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:201
msgid "Splattered Block"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:204
msgid "A dark block breaking into splatter on one side, for weathered and broken surfaces."
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:232
msgid "Dotted Line"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:235
msgid "A row of round dots laid along the stroke, for stitching, tracks and dotted edges."
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:256
msgid "Sparse Specks"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:261
msgid "A few far-apart specks thrown round the stroke, for dust on a surface or distant birds. Under a size of about 10 px its specks are finer than a pixel and it lays little or nothing."
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:284
msgid "Scattered Dots"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:287
msgid "A spray of small dots, each dab turned and sized at random, for snow, pebbles and stippling."
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:308
msgid "Dust"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:311
msgid "Faint broken specks of grit, for dust, rust and the tooth of an old surface."
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:330
msgid "Streaks"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:335
msgid "A band of fine streaks running with the stroke, soft at their ends, for rain, speed and hatched shading. It paints in a mixing blend mode where a mixing module is installed, so over another colour it mixes as paint does, blue over yellow turning green."
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:365
msgid "Ridge"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:368
msgid "A rough ragged line laid along the stroke, for skylines, ridges and broken edges."
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:390
msgid "Palm Fronds"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:393
msgid "A spray of long leaves spaced at their own width, for palms and broad-leaved plants."
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:414
msgid "Leafy Twig"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:417
msgid "A twig with leaves, tilted a little at random each stamp, for hedges and branches."
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:439
msgid "Bush"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:442
msgid "A bush of upright strokes, overlapping into undergrowth along the stroke."
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:463
msgid "Grass Tuft"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:466
msgid "A tuft of grass blades, laid close so a stroke is a strip of meadow."
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:495
msgid "Fir Tree"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:500
msgid "A fir tree stamped along the stroke at varying heights, for a forest edge in one line. The tree is drawn in tones, so only its darkest needles lay the colour at full and the rest of it reads paler."
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:523
msgid "Scribble Marks"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:526
msgid "Loose scribbled marks, turned at random, for lively texture over a flat area."
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:546
msgid "Dry Strokes"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:551
msgid "A dry, scratchy band along the stroke, for catching the light on bark, wood and rough fabric. It paints in Colour Dodge, so it brightens what lies under it towards white whatever the colour picked, and lays nothing visible on white."
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:589
msgid "Lichen"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:592
msgid "A mottled disc of dark rings and light holes, for lichen, foam and stone."
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:611
msgid "Scumble"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:614
msgid "Broken scumbled colour, turned at random, for foliage masses and rough paint."
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:633
msgid "Flecks"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:636
msgid "A cluster of flecks with strays round it, for leaves in the wind and broken highlights."
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:657
msgid "Soft Haze"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:660
msgid "A soft haze with a grain in it, for glow, mist and gentle shading."
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:679
msgid "Cloud Puff"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_drawn_tip_presets.gd:682
msgid "A soft puff of cloud, turned and sized at random, for skies and smoke."
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_habit_presets.gd:37
msgid "Sara residency"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_habit_presets.gd:81
msgid "Pointed Mark"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_habit_presets.gd:86
msgid "A hard round whose size alone follows the pen's pressure, so a stroke pressed in and let go comes to a point and shows its length and its direction. The lightest touch lays a hair a fifth of its width, in the colour picked."
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_habit_presets.gd:110
msgid "Shadow Edge"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_habit_presets.gd:115
msgid "A soft round whose size follows the pen's pressure while its colour stays whole, for an edge that softens along its length, a cast shadow's from the object out."
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_habit_presets.gd:137
msgid "Layer Blender"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_habit_presets.gd:142
msgid "A soft round that blends the paint of the layer it is on and nothing else, so a glaze or a shadow on another layer is not blended into it. Where the layer is bare there is nothing to blend, and it lays the colour picked."
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_habit_presets.gd:172
msgid "Paper Wash"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_habit_presets.gd:177
msgid "A soft wash through the paper's grain that stops at its opacity however often a stroke crosses itself, so a passage laid in one pass is one even tint, for watercolour and ink washes."
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_habit_presets.gd:189
#: modules/sara-base-modules/stamp-brush/presets/sa_shipped_presets.gd:386
#: modules/sara-base-modules/stamp-brush/presets/sa_shipped_presets.gd:414
#: modules/sara-noise-brush-engine/noise_brush_settings.gd:169
msgid "Paper Grain"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_habit_presets.gd:200
#: patterns/canvas_scumble.gmacs:33
msgid "Lift"
msgstr ""

#: modules/sara-base-modules/stamp-brush/presets/sa_habit_presets.gd:205
msgid "An eraser that lifts paint to half its strength and no further however often a stroke crosses itself, for taking a lighter value out of a wash or a graphite tone. It paints in the Erase mode, so the colour picked plays no part."
msgstr ""


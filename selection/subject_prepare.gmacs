# Kernels: subject_clear, subject_gather, subject_flatten, subject_rows, subject_largest, subject_normalise
#
# The picture Select Subject reads, made into U²-NetP's input on the card with
# nothing read back. The reference prepares a photograph as `RescaleT(320)` then
# `ToTensorLab(flag=0)`, and so does this file.
#
# The rescale is a box filter: each texel of the 320 by 320 tensor averages
# sixteen bilinear taps over the part of the canvas it stands for. The
# reference's `skimage.transform.resize` smooths with a Gaussian first, so the
# two differ by a fraction of a level. The tensor stands for the whole canvas
# for Select Subject and for the dragged box grown by its margin for Object
# Selection, so a small object gets every one of the 320 texels.
#
# The source is one texture covering a rectangle of the canvas: the merged
# picture once, or each chunk of the active layer in turn, each adding its taps
# into `sums`. The taps are premultiplied, so a transparent texel adds nothing,
# and `subject_flatten` puts what no tap covered over white.
#
# The network wants sRGB-encoded sRGB in 0 to 1, so the document's numbers go
# through the journey the layers docker's thumbnail takes to the screen. Nothing
# clamps: a colour past white stays past it and `ToTensorLab`'s division by the
# largest value brings it back. That is a two-step reduction (each row's largest,
# then the rows'), then each channel less the ImageNet mean over its deviation.
#
# Tensors are channel after channel and row after row, as PyTorch keeps them
# and as `../network/subject_convolve.gmacs` reads them.
#
# SPDX-License-Identifier: GPL-3.0-or-later

kernel subject_clear
kernel subject_gather
kernel subject_flatten
kernel subject_rows
kernel subject_largest
kernel subject_normalise

import linear_srgb_color_space
import transfer_curve

sampler source

# Premultiplied red, green, blue and coverage, four planes of 320 by 320.
buffer sums: float values[]
# The tensor the network reads, three planes of 320 by 320.
buffer tensor: float values[]
# The largest value of each of the 960 rows, and after them the largest of all.
buffer largest: float values[]

params:
    # The rectangle of the canvas the source covers, in document pixels.
    vec2 source_origin
    vec2 source_size
    # The region of the canvas the tensor stands for, in document pixels.
    vec2 region_origin
    vec2 region_size
    float display_passthrough
    float coordinates
    float to_linear_srgb[9]
    float transfer_slope
    float transfer_threshold
    float transfer_gain
    float transfer_exponent

# The tensor's side, the network's.
const int SIDE = 320
const int PLANE = SIDE * SIDE
# Taps along each side of a tensor texel's footprint.
const int TAPS = 4
# Must match SaColorSpace.Coordinates.
const int SA_COORDS_OKLAB = 1
# `ToTensorLab`'s ImageNet mean and deviation, red, green and blue.
const vec3 MEAN = vec3(0.485, 0.456, 0.406)
const vec3 DEVIATION = vec3(0.229, 0.224, 0.225)


def to_linear_srgb_matrix() -> mat3:
    return mat3(
        to_linear_srgb[0], to_linear_srgb[1], to_linear_srgb[2],
        to_linear_srgb[3], to_linear_srgb[4], to_linear_srgb[5],
        to_linear_srgb[6], to_linear_srgb[7], to_linear_srgb[8]
    )


def to_display(vec3 c) -> vec3:
    """The document's numbers as sRGB-encoded sRGB, the thumbnail's way, and
    exactly the numbers stored for an sRGB document."""
    if display_passthrough > 0.5:
        return c
    vec3 linear
    if int(coordinates + 0.5) == SA_COORDS_OKLAB:
        linear = oklab_to_linear_srgb(c)
    else:
        vec3 document = sa_transfer_decode(c, transfer_slope, transfer_threshold, transfer_gain, transfer_exponent)
        linear = to_linear_srgb_matrix() * document
    return linear_srgb_to_srgb(linear)


@workgroup_size(64, 1)
def subject_clear():
    int at = int(global_id.x)
    if at >= 4 * PLANE:
        return
    sums.values[at] = 0.0


@workgroup_size(64, 1)
def subject_gather():
    """Adds the taps of each tensor texel's footprint that fall inside the
    source's rectangle. A tap belongs to one source, the one whose half-open
    rectangle holds it, so a footprint across a chunk's seam is summed once."""
    int at = int(global_id.x)
    if at >= PLANE:
        return
    int y = at / SIDE
    int x = at - y * SIDE
    vec2 footprint = region_size / SIDE
    vec2 corner = region_origin + vec2(x, y) * footprint
    vec2 low = source_origin
    vec2 high = source_origin + source_size
    if corner.x >= high.x or corner.y >= high.y or corner.x + footprint.x <= low.x or corner.y + footprint.y <= low.y:
        return
    vec4 sum = vec4(0.0)
    for ty in range(0, TAPS):
        for tx in range(0, TAPS):
            vec2 point = corner + (vec2(tx, ty) + 0.5) / TAPS * footprint
            if point.x < low.x or point.y < low.y or point.x >= high.x or point.y >= high.y:
                continue
            vec4 tap = texture(source, (point - low) / source_size)
            sum += vec4(tap.rgb * tap.a, tap.a)
    sums.values[at] += sum.r
    sums.values[PLANE + at] += sum.g
    sums.values[2 * PLANE + at] += sum.b
    sums.values[3 * PLANE + at] += sum.a


@workgroup_size(64, 1)
def subject_flatten():
    """The taps' average in the display's numbers, over white where they were
    not opaque, into the tensor's three planes."""
    int at = int(global_id.x)
    if at >= PLANE:
        return
    float taps = TAPS * TAPS
    float alpha = sums.values[3 * PLANE + at]
    vec3 straight = vec3(sums.values[at], sums.values[PLANE + at], sums.values[2 * PLANE + at]) / max(alpha, 0.000001)
    float coverage = alpha / taps
    vec3 shown = to_display(straight) * coverage + vec3(1.0 - coverage)
    tensor.values[at] = shown.r
    tensor.values[PLANE + at] = shown.g
    tensor.values[2 * PLANE + at] = shown.b


@workgroup_size(64, 1)
def subject_rows():
    int row = int(global_id.x)
    if row >= 3 * SIDE:
        return
    int base = row * SIDE
    float most = tensor.values[base]
    for x in range(1, SIDE):
        most = max(most, tensor.values[base + x])
    largest.values[row] = most


@workgroup_size(64, 1)
def subject_largest():
    if int(global_id.x) != 0:
        return
    float most = largest.values[0]
    for row in range(1, 3 * SIDE):
        most = max(most, largest.values[row])
    largest.values[3 * SIDE] = most


@workgroup_size(64, 1)
def subject_normalise():
    """`ToTensorLab(flag=0)`: the picture over its largest value, and each
    channel less the mean over the deviation. A picture with nothing above
    nought is left unscaled rather than divided by it."""
    int at = int(global_id.x)
    if at >= PLANE:
        return
    float most = largest.values[3 * SIDE]
    float scale = most > 0.0 ? 1.0 / most : 1.0
    for channel in range(0, 3):
        int index = channel * PLANE + at
        tensor.values[index] = (tensor.values[index] * scale - MEAN[channel]) / DEVIATION[channel]

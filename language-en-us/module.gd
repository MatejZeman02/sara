## American English, a language module like any other: one catalogue,
## `en_US.po`, that respells Sara's British sentences.
##
## SPDX-License-Identifier: GPL-3.0-or-later
##
## The catalogue is generated by `scripts/write_en_us.py` from the tree and the
## table beside this script, `spellings.json`, and the gate's
## `write_en_us.py --check` fails when a new sentence carries a British word
## the catalogue does not hold. It loads at every launch and changes nothing
## until a painter picks English (United States) on Preferences > Languages,
## since the profile's language stays `en_GB`.
##
## Beside it the module installs [British], a catalogue for `en_GB` that
## answers every message with itself. Godot answers a locale from the catalogue
## that matches it best, so with `en_US.po` installed alone it answers `en`,
## `en_GB` and every fallback to English in American. The exact match
## keeps British English British. It is built in code and never a file, so it
## holds every message the tree will ever show, and it goes in
## `TranslationServer` directly, since the registry copies a catalogue's
## sentences into a plain `Translation` and an answer computed on lookup would
## not survive the copy.
##
## The catalogue is found beside this script, so a copy of the folder in a
## user's modules folder reads the same.
extends SaModule

## The catalogue's file, beside this script.
const CATALOGUE_FILE := "en_US.po"

## The locale the catalogue is for, which its `Language` line names.
const LOCALE := "en_US"

## The locale of Sara's own British English, which [British] answers for. It is
## the default of the profile's `ui_language` in core, written here again
## because a module sees the door and not core's settings.
const BRITISH := "en_GB"


func get_id() -> StringName:
    return &"language-en-us"


func get_name() -> String:
    return "American English"


## The identity catalogue for `en_GB`, in `TranslationServer` while the module
## is loaded.
var _british: British = null


func register(ctx: SaContext) -> void:
    ctx.register_translation(catalogue_path())
    _british = British.new()
    TranslationServer.add_translation(_british)


func unregister(_ctx: SaContext) -> void:
    if _british != null:
        TranslationServer.remove_translation(_british)
    _british = null


## The catalogue's path, beside wherever this script was loaded from.
func catalogue_path() -> String:
    return (get_script() as Script).resource_path.get_base_dir().path_join(CATALOGUE_FILE)


## British English, Sara's own language, as a catalogue: every message is its
## own translation, so `en_GB` matches exactly and the American one never
## answers for it. A plural picks its form by English's rule.
class British:
    extends Translation

    func _init() -> void:
        locale = BRITISH

    func _get_message(src_message: StringName, _context: StringName) -> StringName:
        return src_message

    func _get_plural_message(src_message: StringName, src_plural_message: StringName, n: int, _context: StringName) -> StringName:
        return src_message if n == 1 else src_plural_message
